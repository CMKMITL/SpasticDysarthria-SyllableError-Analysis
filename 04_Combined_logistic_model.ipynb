{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Combined logistic regression model\n",
    "\n",
    "Reproduce Figure 4, Supplementary Figure S2, and Supplementary Tables S4–S5. Run notebook 01 first."
   ],
   "id": "cell-00"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Load the scores and statistical functions"
   ],
   "id": "cell-01"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "from IPython.display import display\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "ROOT = Path.cwd()\n",
    "if not (ROOT / 'syllableseparation_apple_corrected.csv').is_file():\n",
    "    raise FileNotFoundError('Open this notebook from the repository folder.')\n",
    "output_dir = ROOT / 'results'\n",
    "output_dir.mkdir(exist_ok=True)\n",
    "plt.rcParams.update({'font.family': 'DejaVu Sans', 'font.size': 9,\n",
    "                     'axes.linewidth': .8, 'pdf.fonttype': 42})\n",
    "\n",
    "def save_figure(fig, name):\n",
    "    fig.savefig(output_dir / f'{name}.png', dpi=300, bbox_inches='tight', facecolor='white')\n",
    "    fig.savefig(output_dir / f'{name}.pdf', bbox_inches='tight', facecolor='white')\n",
    "    plt.show()\n",
    "    plt.close(fig)\n",
    "df = pd.read_csv(ROOT / 'Syllableerror_scores_raw_and_normalized.csv', dtype={'sub_id': str})\n",
    "features = [f'error_rate_{i}' for i in range(1, 5)]\n",
    "raw_columns = [f'error_{i}' for i in range(1, 5)]\n",
    "sentences = ['LBP', 'LAP', 'VP', 'MP']\n",
    "assert len(df) == 74 and df['sub_id'].is_unique\n",
    "assert df['disease'].value_counts().to_dict() == {0: 37, 1: 37}\n",
    "assert np.isfinite(df[features + raw_columns].to_numpy()).all()\n",
    "assert np.allclose(df[features], df[raw_columns].to_numpy() / [8, 8, 7, 11])\n",
    "df['pooled'] = df[raw_columns].sum(axis=1) / 34\n",
    "from scipy.stats import norm\n",
    "from sklearn.metrics import roc_curve, roc_auc_score, confusion_matrix\n",
    "from statsmodels.stats.multitest import multipletests\n",
    "\n",
    "def delong(labels, scores):\n",
    "    labels = np.asarray(labels)\n",
    "    scores = np.asarray(scores, dtype=float)\n",
    "    if scores.ndim == 1:\n",
    "        scores = scores[:, None]\n",
    "    positive, negative = scores[labels == 1].T, scores[labels == 0].T\n",
    "    h = (positive[:, :, None] > negative[:, None, :]).astype(float)\n",
    "    h += .5 * (positive[:, :, None] == negative[:, None, :])\n",
    "    covariance = (np.atleast_2d(np.cov(h.mean(axis=2), ddof=1)) / positive.shape[1]\n",
    "                  + np.atleast_2d(np.cov(h.mean(axis=1), ddof=1)) / negative.shape[1])\n",
    "    return h.mean(axis=(1, 2)), covariance\n",
    "\n",
    "def auc_table(labels, scores, names):\n",
    "    auc, covariance = delong(labels, scores)\n",
    "    se = np.sqrt(np.maximum(0, np.diag(covariance)))\n",
    "    table = pd.DataFrame({'Sentence': names, 'AUC': auc,\n",
    "                          'Lower95': np.maximum(0, auc - norm.ppf(.975) * se),\n",
    "                          'Upper95': np.minimum(1, auc + norm.ppf(.975) * se)})\n",
    "    assert np.allclose(auc, [roc_auc_score(labels, s) for s in np.asarray(scores).T])\n",
    "    return table, covariance\n",
    "\n",
    "def compare_auc(table, covariance, pairs):\n",
    "    rows = []\n",
    "    for i, j in pairs:\n",
    "        difference = table.iloc[i]['AUC'] - table.iloc[j]['AUC']\n",
    "        se = np.sqrt(max(0, covariance[i, i] + covariance[j, j] - 2 * covariance[i, j]))\n",
    "        p = 2 * norm.sf(abs(difference) / se) if se > 0 else (1. if abs(difference) < 1e-12 else np.nan)\n",
    "        rows.append({'A': table.iloc[i]['Sentence'], 'B': table.iloc[j]['Sentence'],\n",
    "                     'AUC_difference': difference, 'Lower95': max(-1, difference - norm.ppf(.975) * se),\n",
    "                     'Upper95': min(1, difference + norm.ppf(.975) * se), 'p_raw': p})\n",
    "    result = pd.DataFrame(rows)\n",
    "    if not np.isfinite(result['p_raw']).all():\n",
    "        raise ValueError('Undefined DeLong comparison.')\n",
    "    result['p_Holm'] = multipletests(result['p_raw'], method='holm')[1]\n",
    "    return result\n",
    "\n",
    "def youden(labels, scores):\n",
    "    fpr, tpr, thresholds = roc_curve(labels, scores, drop_intermediate=False)\n",
    "    valid = np.isfinite(thresholds)\n",
    "    thresholds, j = thresholds[valid], (tpr - fpr)[valid]\n",
    "    return float(thresholds[np.isclose(j, j.max(), rtol=0, atol=1e-12)].max())\n",
    "\n",
    "def ratio(a, b):\n",
    "    return a / b if b else (np.inf if a else np.nan)\n",
    "\n",
    "def performance(labels, scores, threshold):\n",
    "    tn, fp, fn, tp = confusion_matrix(labels, np.asarray(scores) >= threshold, labels=[0, 1]).ravel()\n",
    "    sensitivity, specificity = ratio(tp, tp + fn), ratio(tn, tn + fp)\n",
    "    return {'Threshold': threshold, 'TP': int(tp), 'FN': int(fn), 'TN': int(tn), 'FP': int(fp),\n",
    "            'Accuracy': (tp + tn) / len(labels), 'Sensitivity': sensitivity, 'Specificity': specificity,\n",
    "            'Youden_J': sensitivity + specificity - 1,\n",
    "            'LR+': ratio(sensitivity, 1 - specificity), 'LR-': ratio(1 - sensitivity, specificity)}"
   ],
   "id": "cell-02"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Configure the model\n",
    "\n",
    "Use 50 stratified 70:30 partitions, training-only standardization, L2 logistic regression, and five-fold training-set grid search."
   ],
   "id": "cell-03"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from sklearn.model_selection import train_test_split, StratifiedKFold, GridSearchCV\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from joblib import Parallel, delayed, parallel_config\n",
    "import os\n",
    "\n",
    "X, y = df[features], df['disease']\n",
    "N_SPLITS, N_REPEATS, N_FOLDS = 50, 100, 5\n",
    "RUN_NESTED_CV = os.environ.get('SKIP_NESTED_CV', '0') != '1'\n",
    "C_GRID = np.logspace(-4, 4, 17)\n",
    "split_seeds = np.arange(42, 42 + N_SPLITS)\n",
    "names = sentences + ['Pooled', 'Combined']\n",
    "\n",
    "def create_model():\n",
    "    return Pipeline([('scaler', StandardScaler()),\n",
    "                     ('logisticregression', LogisticRegression(penalty='l2', solver='lbfgs',\n",
    "                                                               max_iter=5000, random_state=42))])\n",
    "\n",
    "def fit_split(split_number, seed):\n",
    "    train_index, test_index = train_test_split(df.index, test_size=.30, stratify=y, random_state=int(seed))\n",
    "    search = GridSearchCV(create_model(), {'logisticregression__C': C_GRID}, scoring='roc_auc',\n",
    "                          cv=StratifiedKFold(n_splits=5, shuffle=True, random_state=42), n_jobs=1, refit=True)\n",
    "    search.fit(X.loc[train_index], y.loc[train_index])\n",
    "    probabilities = search.predict_proba(X.loc[test_index])[:, 1]\n",
    "    threshold = youden(y.loc[train_index], search.predict_proba(X.loc[train_index])[:, 1])\n",
    "    return {'split': split_number, 'seed': int(seed), 'train_index': train_index,\n",
    "            'test_index': test_index, 'model': search.best_estimator_, 'C': search.best_params_['logisticregression__C'],\n",
    "            'probabilities': probabilities, 'threshold': threshold}"
   ],
   "id": "cell-04"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Fit the 50 final models\n",
    "\n",
    "Each Youden threshold is derived from its full training subset and applied unchanged to the corresponding test subset. The AUC summary retains the original empirical (nearest-rank) quartiles."
   ],
   "id": "cell-05"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "with parallel_config(backend='loky', inner_max_num_threads=1):\n",
    "    fitted_splits = Parallel(n_jobs=min(4, os.cpu_count() or 1))(\n",
    "        delayed(fit_split)(i, seed) for i, seed in enumerate(split_seeds, 1))\n",
    "\n",
    "performance_rows, auc_rows, prediction_rows, coefficient_rows = [], [], [], []\n",
    "for split in fitted_splits:\n",
    "    idx = split['test_index']\n",
    "    probabilities = split['probabilities']\n",
    "    performance_rows.append({'Split': split['split'], 'Seed': split['seed'], 'C': split['C'],\n",
    "                             'AUC': roc_auc_score(y.loc[idx], probabilities),\n",
    "                             **performance(y.loc[idx], probabilities, split['threshold'])})\n",
    "    six_scores = np.column_stack([df.loc[idx, features + ['pooled']], probabilities])\n",
    "    for name, score in zip(names, six_scores.T):\n",
    "        auc_rows.append({'Split': split['split'], 'Sentence': name, 'AUC': roc_auc_score(y.loc[idx], score)})\n",
    "    for index, probability in zip(idx, probabilities):\n",
    "        prediction_rows.append({'Split': split['split'], 'Seed': split['seed'], 'sub_id': df.loc[index, 'sub_id'],\n",
    "                                'disease': y.loc[index], 'Probability': probability, 'Threshold': split['threshold']})\n",
    "    model = split['model']\n",
    "    beta = model.named_steps['logisticregression'].coef_[0]\n",
    "    beta_010 = beta / model.named_steps['scaler'].scale_ * .10\n",
    "    for name, standardized, rescaled in zip(sentences, beta, beta_010):\n",
    "        coefficient_rows.append({'Split': split['split'], 'Sentence': name,\n",
    "                                 'Standardized_beta': standardized, 'Beta_per_0.10': rescaled})\n",
    "performance_df = pd.DataFrame(performance_rows)\n",
    "auc_splits_df = pd.DataFrame(auc_rows)\n",
    "coefficient_df = pd.DataFrame(coefficient_rows)\n",
    "performance_df.to_csv(output_dir / 'Combined_50_split_performance.csv', index=False)\n",
    "auc_splits_df.to_csv(output_dir / 'FigureS2_test_AUCs.csv', index=False)\n",
    "pd.DataFrame(prediction_rows).to_csv(output_dir / 'Combined_test_predictions.csv', index=False)\n",
    "coefficient_df.to_csv(output_dir / 'Combined_coefficients.csv', index=False)\n",
    "\n",
    "values = performance_df.AUC.to_numpy()\n",
    "auc_summary = pd.DataFrame([{'Median': np.quantile(values, .5, method='inverted_cdf'),\n",
    "                             'Q1': np.quantile(values, .25, method='inverted_cdf'),\n",
    "                             'Q3': np.quantile(values, .75, method='inverted_cdf')}])\n",
    "auc_summary.to_csv(output_dir / 'Combined_AUC_summary.csv', index=False)\n",
    "display(auc_summary.round(3))"
   ],
   "id": "cell-06"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Select and compare the representative model\n",
    "\n",
    "Select the test AUC closest to the median. All six scores are evaluated on the same 23 participants. Holm correction covers five model-versus-score comparisons. 
   ],
   "id": "cell-07"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "distance = np.abs(performance_df.AUC - performance_df.AUC.median())\n",
    "position = np.flatnonzero(np.isclose(distance, distance.min(), rtol=0, atol=1e-12))[0]\n",
    "representative = fitted_splits[position]\n",
    "idx = representative['test_index']\n",
    "labels = y.loc[idx].to_numpy()\n",
    "scores = np.column_stack([df.loc[idx, features + ['pooled']], representative['probabilities']])\n",
    "test_auc_df, covariance = auc_table(labels, scores, names)\n",
    "test_comparison_df = compare_auc(test_auc_df, covariance, [(5, i) for i in range(5)])\n",
    "test_auc_df.to_csv(output_dir / 'Figure4_AUC.csv', index=False)\n",
    "test_comparison_df.to_csv(output_dir / 'Figure4_paired_DeLong_Holm5.csv', index=False)\n",
    "observed = performance(labels, representative['probabilities'], representative['threshold'])\n",
    "pd.DataFrame([{'Split': representative['split'], 'Seed': representative['seed'], **observed}]).to_csv(\n",
    "    output_dir / 'Representative_observed_performance.csv', index=False)\n",
    "print('Representative split:', representative['split'], 'seed:', representative['seed'])\n",
    "display(test_auc_df.round(3))\n",
    "display(test_comparison_df.round(6))"
   ],
   "id": "cell-08"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Calculate Supplementary Table S4\n",
    "\n",
    "Independent Jeffreys Beta(0.5, 0.5) priors and 200,000 draws (seed 42). Intervals are conditional on the selected model and test participants."
   ],
   "id": "cell-09"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "tp, fn, tn, fp = [observed[key] for key in ['TP', 'FN', 'TN', 'FP']]\n",
    "rng = np.random.default_rng(42)\n",
    "n_draws = 200000\n",
    "accuracy_draws = rng.beta(tp + tn + .5, fp + fn + .5, size=n_draws)\n",
    "sensitivity_draws = rng.beta(tp + .5, fn + .5, size=n_draws)\n",
    "specificity_draws = rng.beta(tn + .5, fp + .5, size=n_draws)\n",
    "draws = {'Accuracy': accuracy_draws, 'Sensitivity': sensitivity_draws, 'Specificity': specificity_draws,\n",
    "         'LR+': sensitivity_draws / (1 - specificity_draws), 'LR-': (1 - sensitivity_draws) / specificity_draws}\n",
    "rows = []\n",
    "for name, values in draws.items():\n",
    "    lower, median, upper = np.quantile(values, [.025, .5, .975])\n",
    "    rows.append({'Metric': name, 'Observed': observed[name], 'Posterior_median': median,\n",
    "                 'CrI_lower': lower, 'CrI_upper': upper})\n",
    "posterior_df = pd.DataFrame(rows)\n",
    "posterior_df.to_csv(output_dir / 'TableS4_representative_performance.csv', index=False)\n",
    "display(posterior_df.round(3))"
   ],
   "id": "cell-10"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 6: Calculate Supplementary Table S5\n",
    "\n",
    "Summaries describe overlapping partitions and are not confidence intervals or formal tests of coefficient differences. Rescale standardized coefficients by the training-set standard deviation to obtain coefficients per 0.10 increase in normalized error score."
   ],
   "id": "cell-11"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "rows = []\n",
    "for scale in ['Standardized_beta', 'Beta_per_0.10']:\n",
    "    for name in sentences:\n",
    "        values = coefficient_df.loc[coefficient_df.Sentence == name, scale]\n",
    "        q1, median, q3 = values.quantile([.25, .5, .75])\n",
    "        rows.append({'Scale': scale, 'Sentence': name, 'N_models': len(values),\n",
    "                     'Mean': values.mean(), 'SD': values.std(ddof=1), 'Median': median,\n",
    "                     'Q1': q1, 'Q3': q3, 'Positive_n': int((values > 0).sum()),\n",
    "                     'Positive_percent': 100 * (values > 0).mean()})\n",
    "coefficient_summary = pd.DataFrame(rows)\n",
    "coefficient_summary.to_csv(output_dir / 'TableS5_coefficients.csv', index=False)\n",
    "display(coefficient_summary.round(4))"
   ],
   "id": "cell-12"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 7: Draw Supplementary Figure S2\n",
    "\n",
   ],
   "id": "cell-13"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "sentence_colors = ['#0072B2', '#D55E00', '#009E73', '#CC79A7', '#222222', '#7A5195']\n",
    "plt.rcParams.update({\n",
    "    'font.family': ['DejaVu Sans'],\n",
    "    'font.size': 9,\n",
    "    'axes.linewidth': .8,\n",
    "    'pdf.fonttype': 42,\n",
    "    'ps.fonttype': 42,\n",
    "    'svg.fonttype': 'none'\n",
    "})\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(180 / 25.4, 4.5))\n",
    "rng = np.random.default_rng(2026)\n",
    "\n",
    "for i, name in enumerate(names):\n",
    "    values = auc_splits_df.loc[\n",
    "        auc_splits_df['Sentence'] == name, 'AUC'\n",
    "    ].to_numpy()\n",
    "\n",
    "    if np.ptp(values) > 0:\n",
    "        violin = ax.violinplot(\n",
    "            values, positions=[i], widths=.75,\n",
    "            showmeans=False, showmedians=False, showextrema=False\n",
    "        )\n",
    "        for body in violin['bodies']:\n",
    "            body.set_facecolor(sentence_colors[i])\n",
    "            body.set_edgecolor(sentence_colors[i])\n",
    "            body.set_alpha(.45)\n",
    "\n",
    "    ax.scatter(\n",
    "        i + rng.uniform(-.07, .07, len(values)), values,\n",
    "        s=9, color=sentence_colors[i], alpha=.65, zorder=3\n",
    "    )\n",
    "\n",
    "    q1, median, q3 = np.quantile(values, [.25, .5, .75])\n",
    "    ax.plot([i, i], [q1, q3], color='.2', lw=5, zorder=4)\n",
    "    ax.scatter(\n",
    "        i, median, s=25, facecolor='white',\n",
    "        edgecolor='.2', linewidth=.8, zorder=5\n",
    "    )\n",
    "    ax.text(\n",
    "        i, 1.025, f'{median:.3f}',\n",
    "        ha='center', va='bottom', fontsize=9\n",
    "    )\n",
    "\n",
    "ax.set(\n",
    "    xticks=range(6), xticklabels=names,\n",
    "    xlim=(-.6, 5.6), ylim=(0, 1.12),\n",
    "    ylabel='Test-set AUC',\n",
    "    xlabel=f'{N_SPLITS} repeated stratified train–test splits'\n",
    ")\n",
    "ax.set_yticks(np.arange(0, 1.01, .2))\n",
    "ax.set_title('AUC distributions across test splits', loc='left')\n",
    "ax.text(\n",
    "    .5, .98, 'Numbers: median AUC',\n",
    "    transform=ax.transAxes, ha='center', va='top', fontsize=8\n",
    ")\n",
    "\n",
    "fig.tight_layout()\n",
    "save_figure(fig, 'FigureS2_AUC_distributions')"
   ],
   "id": "cell-14"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 8: Draw Figure 4"
   ],
   "id": "cell-15"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "colors = {'LBP': '#0072B2', 'LAP': '#D55E00', 'VP': '#009E73',\n",
    "          'MP': '#CC79A7', 'Pooled': '#222222', 'Combined': '#7A5195'}\n",
    "\n",
    "def auc_bars(ax, table, comparisons, title):\n",
    "    names = table['Sentence'].tolist()\n",
    "    auc = table['AUC'].to_numpy()\n",
    "    lower, upper = table['Lower95'].to_numpy(), table['Upper95'].to_numpy()\n",
    "    x = np.arange(len(names))\n",
    "    ax.bar(x, auc, width=.62, color=[colors[n] for n in names], zorder=3)\n",
    "    ax.errorbar(x, auc, yerr=[auc - lower, upper - auc], fmt='none',\n",
    "                ecolor='.25', elinewidth=1, capsize=4, zorder=4)\n",
    "    ax.axhline(.5, color='.6', linestyle='--', linewidth=.8)\n",
    "    significant = comparisons.loc[comparisons['p_Holm'] < .05].copy()\n",
    "    significant['span'] = [abs(names.index(a) - names.index(b)) for a, b in zip(significant.A, significant.B)]\n",
    "    significant = significant.sort_values('span', kind='stable').reset_index(drop=True)\n",
    "    for level, row in significant.iterrows():\n",
    "        left, right = sorted([names.index(row.A), names.index(row.B)])\n",
    "        height = 1.10 + level * .075\n",
    "        ax.plot([left, left, right, right], [height, height + .018, height + .018, height], color='.3', lw=.8)\n",
    "        stars = '***' if row.p_Holm < .001 else '**' if row.p_Holm < .01 else '*'\n",
    "        ax.text((left + right) / 2, height + .021, stars, ha='center', va='bottom')\n",
    "    top = 1.24 + max(0, len(significant) - 1) * .075\n",
    "    ax.set(xlim=(-.6, len(names) - .4), ylim=(0, top), xticks=x, xticklabels=names,\n",
    "           yticks=np.arange(0, 1.01, .2), ylabel='AUC')\n",
    "    ax.set_title(title, loc='left', fontweight='bold', fontsize=10, pad=10)\n",
    "    ax.set_axisbelow(True)\n",
    "    ax.grid(axis='y', color='.9', linewidth=.5)\n",
    "    table_artist = ax.table(cellText=[[f'{a:.3f}' for a in auc],\n",
    "                                    [f'{l:.3f}–{u:.3f}' for l, u in zip(lower, upper)]],\n",
    "                            rowLabels=['AUC', '95% CI'], cellLoc='center', rowLoc='right',\n",
    "                            bbox=[0, -.28, 1, .15])\n",
    "    table_artist.auto_set_font_size(False)\n",
    "    table_artist.set_fontsize(7)\n",
    "    for (row, col), cell in table_artist.get_celld().items():\n",
    "        cell.set_edgecolor('white')\n",
    "        if row == 0 and col >= 0:\n",
    "            cell.get_text().set_color(colors[names[col]])\n",
    "            cell.get_text().set_fontweight('bold')\n",
