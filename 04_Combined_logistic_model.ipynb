   "source": [
    "## Step 9: Repeat nested validation within each training subset\n",
    "\n",
    "Retain the manuscript procedure: 100 repetitions of outer five-fold validation with inner five-fold tuning for each of the 50 training subsets. These validation estimates are separate from the final training-set grid search and do not select the representative model. This step is computationally intensive."
   ],
   "id": "cell-17"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def nested_validation(split_number, seed):\n",
    "    train_index, _ = train_test_split(df.index, test_size=.30, stratify=y, random_state=int(seed))\n",
    "    x_train, y_train = X.loc[train_index], y.loc[train_index]\n",
    "    rows = []\n",
    "    for repeat in range(N_REPEATS):\n",
    "        outer_cv = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=1000 + repeat)\n",
    "        probabilities = np.zeros(len(train_index))\n",
    "        for fold, (fit_index, valid_index) in enumerate(outer_cv.split(x_train, y_train)):\n",
    "            inner_cv = StratifiedKFold(n_splits=N_FOLDS, shuffle=True,\n",
    "                                      random_state=2000 + repeat * N_FOLDS + fold)\n",
    "            search = GridSearchCV(create_model(), {'logisticregression__C': C_GRID},\n",
    "                                  scoring='roc_auc', cv=inner_cv, n_jobs=1, refit=True)\n",
    "            search.fit(x_train.iloc[fit_index], y_train.iloc[fit_index])\n",
    "            probabilities[valid_index] = search.predict_proba(x_train.iloc[valid_index])[:, 1]\n",
    "        rows.append({'Split': split_number, 'Repeat': repeat + 1,\n",
    "                     'Nested_OOF_AUC': roc_auc_score(y_train, probabilities)})\n",
    "    result = pd.DataFrame(rows)\n",
    "    result.to_csv(output_dir / f'Nested_validation_split_{split_number:02d}.csv', index=False)\n",
    "    print(f'Nested validation completed: split {split_number}/{N_SPLITS}', flush=True)\n",
    "    return result\n",
    "\n",
    "if RUN_NESTED_CV:\n",
    "    with parallel_config(backend='loky', inner_max_num_threads=1):\n",
    "        nested_results = Parallel(n_jobs=min(4, os.cpu_count() or 1))(\n",
    "            delayed(nested_validation)(i, seed) for i, seed in enumerate(split_seeds, 1))\n",
    "    pd.concat(nested_results, ignore_index=True).to_csv(output_dir / 'Nested_validation.csv', index=False)\n",
    "else:\n",
    "    print('Repeated nested validation skipped explicitly; final model fits and manuscript outputs were regenerated.')"
   ],
